{
	"name": "sky-watch",
	"private": true,
	"type": "module",
	"scripts": {
		"check": "node source/index.ts",
		"format": "oxlint --fix . && oxfmt .",
		"knip": "knip",
		"lint": "oxfmt --check . && oxlint .",
		"test": "tsc"
	},
	"dependencies": {
		"@actions/core": "^3.0.1",
		"diff": "^9.0.0"
	},
	"devDependencies": {
		"@types/node": "^26.6.10",
		"knip": "^6.48.0",
		"oxfmt": "0.80.0",
		"oxlint": "1.95.0",
		"oxlint-tsgolint": "7.0.2008",
		"typescript": "^7.0.2"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.16.1",
			"onFail": "error"
		},
		"runtime": {
			"name": "node",
			"version": ">=26",
			"onFail": "error"
		}
